{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "paths": {
      "@/*": ["src/*"],
      "@test/*": ["test/*"]
    },
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": ["jest", "node"],
    "moduleResolution": "node",
    "resolvePackageJsonExports": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
